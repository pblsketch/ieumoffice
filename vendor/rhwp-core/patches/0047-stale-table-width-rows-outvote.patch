+//! 닫는 행들이 개체 폭을 넘어 같은 폭으로 합의하면 그 행들은 무효 행이 아니다.
+//!
+//! 합성 표로 보는 판정 계약이다(렌더 기준선 아님). 근거가 된 한컴 한글 2024 인쇄
+//! 실측은 `src/model/table/stale_width.rs` 머리말에 있다: 개체 폭 41,563HU, 닫는 행
+//! 7개가 모두 46,971HU 인 TAC 표를 한컴은 칸 폭으로 그린다.
+use rhwp::model::table::{Cell, Table};
+use std::collections::BTreeSet;
+
+fn cell(row: u16, col: u16, span: u16, width: u32) -> Cell {
+    Cell {
+        row,
+        col,
+        col_span: span,
+        row_span: 1,
+        width,
+        ..Default::default()
+    }
+}
+
+fn table(rows: u16, cols: u16, width: u32, cells: Vec<Cell>) -> Table {
+    let mut table = Table {
+        row_count: rows,
+        col_count: cols,
+        cells,
+        ..Default::default()
+    };
+    table.common.width = width;
+    table
+}
+
+#[test]
+fn closing_rows_that_agree_beyond_the_table_width_are_valid() {
+    // 개체 폭 1000, 닫는 행 셋이 모두 1200.
+    let table = table(
+        3,
+        2,
+        1000,
+        vec![
+            cell(0, 0, 1, 600),
+            cell(0, 1, 1, 600),
+            cell(1, 0, 1, 500),
+            cell(1, 1, 1, 700),
+            cell(2, 0, 2, 1200),
+        ],
+    );
+    assert!(table.invalid_declared_width_rows().is_empty());
+}
+
+#[test]
+fn rows_closed_only_by_a_vertical_span_do_not_take_part() {
+    // 0행의 첫 칸이 1행까지 내려온다. 0·1행은 혼자 닫지 못하고, 2·3행이 합의한다.
+    let mut spanning = cell(0, 0, 1, 600);
+    spanning.row_span = 2;
+    let table = table(
+        4,
+        2,
+        1000,
+        vec![
+            spanning,
+            cell(0, 1, 1, 600),
+            cell(1, 1, 1, 600),
+            cell(2, 0, 1, 600),
+            cell(2, 1, 1, 600),
+            cell(3, 0, 2, 1201), // 열마다 2HU 까지는 같은 격자다
+        ],
+    );
+    assert!(table.invalid_declared_width_rows().is_empty());
+}
+
+#[test]
+fn a_single_wide_closing_row_stays_invalid() {
+    let mut spanning = cell(0, 0, 1, 500);
+    spanning.row_span = 2;
+    let table = table(
+        3,
+        2,
+        1000,
+        vec![
+            spanning,
+            cell(0, 1, 1, 500),
+            cell(1, 1, 1, 500),
+            cell(2, 0, 2, 1200),
+        ],
+    );
+    assert_eq!(table.invalid_declared_width_rows(), BTreeSet::from([2]));
+}
+
+#[test]
+fn wide_closing_rows_that_disagree_stay_invalid() {
+    let table = table(
+        2,
+        2,
+        1000,
+        vec![cell(0, 0, 1, 600), cell(0, 1, 1, 600), cell(1, 0, 2, 1300)],
+    );
+    assert_eq!(table.invalid_declared_width_rows(), BTreeSet::from([0, 1]));
+}
+
+#[test]
+fn a_closing_row_that_matches_the_table_width_keeps_the_table_width() {
+    let table = table(
+        3,
+        2,
+        1000,
+        vec![
+            cell(0, 0, 1, 500),
+            cell(0, 1, 1, 500),
+            cell(1, 0, 1, 600),
+            cell(1, 1, 1, 600),
+            cell(2, 0, 2, 1200),
+        ],
+    );
+    assert_eq!(table.invalid_declared_width_rows(), BTreeSet::from([1, 2]));
+}
+
+#[test]
+fn a_fully_closed_inline_table_keeps_its_own_consensus_path() {
+    // 모든 행이 닫히고 행 병합이 없는 TAC 표는 `closed_inline_grid_width_hu` 가 맡는다.
+    // 이 판정은 그 표의 무효 행 집합을 바꾸지 않는다.
+    let mut table = table(
+        2,
+        2,
+        1000,
+        vec![cell(0, 0, 1, 600), cell(0, 1, 1, 600), cell(1, 0, 2, 1200)],
+    );
+    table.common.treat_as_char = true;
+    assert_eq!(table.invalid_declared_width_rows(), BTreeSet::from([0, 1]));
+}
