@@ -0,0 +1,95 @@
+//! 개체 폭이 낡은 표: 표를 닫는 행들이 개체 폭보다 넓고 서로 같은 폭이다.
+//!
+//! 한글은 표 개체의 크기와 칸 폭을 따로 저장한다. 칸 폭이 바뀐 뒤에도 개체 크기가 옛
+//! 값으로 남은 문서가 있다. 그런 표에서는 표를 혼자 닫는 행(위 행에서 내려온 병합 칸
+//! 없이 제 칸만으로 모든 열을 한 번씩 덮는 행)이 모두 개체 폭보다 넓고, 그 합이 서로
+//! 같다. 어긋난 값은 행들이 아니라 개체 폭이다.
+//!
+//! 한컴 한글 2024 인쇄 실측(TAC 표 18행 9열, 개체 폭 41,563HU, 닫는 행 7개가 모두
+//! 46,971HU): 표를 칸 폭으로 그린다. 칸 폭 등식이 엇갈리는 곳(15행의 4번 칸 끝
+//! 35,158HU 가 다른 행이 정한 6번 경계 34,377HU 뒤에 있다)은 칸 폭을 하한으로 보고
+//! 뒤 경계를 민다. 6번 경계가 35,158HU 로 밀리고 표 오른쪽 끝은 47,752HU 가 된다.
+//! 표가 닫는 행의 폭(46,971HU)보다도 넓어진다.
+//!
+//! 모든 행이 닫히고 행 병합이 없는 TAC 표는 `closed_inline_grid_width_hu` 가 이미 같은
+//! 판단을 한다. 여기서는 그 밖의 표(행 병합이 섞인 표, TAC 가 아닌 표)를 맡는다.
+
+use super::{Cell, Table};
+use crate::storage::Storage;
+use std::collections::{BTreeMap, BTreeSet};
+
+/// 저장 HWPUNIT 은 정수라 같은 격자를 적은 행도 열마다 1~2HU 씩 다를 수 있다.
+const ROW_AGREEMENT_TOLERANCE_PER_COLUMN_HU: u64 = 2;
+
+impl Table {
+    /// 닫는 행들이 개체 폭을 넘어 같은 폭으로 합의했는가.
+    /// `invalid_declared_width_rows` 와 같은 허용치로 본다.
+    pub(crate) fn rows_outvote_declared_width_with_storage<S: Storage>(
+        &self,
+        storage: &S,
+    ) -> Result<bool, S::Error> {
+        let tolerance = self.declared_width_tolerance_hu();
+        let exceeding = self.declared_width_rows_exceeding_with_storage(tolerance, storage)?;
+        self.exceeding_rows_outvote_declared_width_with_storage(&exceeding, storage)
+    }
+
+    /// `exceeding` 은 개체 폭보다 허용치 넘게 넓은 닫는 행이다
+    /// (`declared_width_rows_exceeding_with_storage` 의 결과).
+    ///
+    /// 닫는 행이 둘 이상이고, 하나도 빠짐없이 `exceeding` 에 들고, 합이 서로 같을 때만
+    /// 참이다. 닫는 행이 하나뿐이면 그 행이 틀린 것일 수 있어 근거가 못 된다. 개체 폭과
+    /// 맞는 닫는 행이 하나라도 있으면 개체 폭이 근거다.
+    pub(super) fn exceeding_rows_outvote_declared_width_with_storage<S: Storage>(
+        &self,
+        exceeding: &BTreeSet<u16>,
+        storage: &S,
+    ) -> Result<bool, S::Error> {
+        let col_count = usize::from(self.col_count);
+        if exceeding.len() < 2
+            || col_count == 0
+            || self.common.width == 0
+            || self
+                .closed_inline_grid_width_hu_with_storage(storage)?
+                .is_some()
+        {
+            return Ok(false);
+        }
+        let mut by_row = BTreeMap::<u16, Vec<&Cell>>::new();
+        for cell in &self.cells {
+            if cell.row < self.row_count && cell.row_span == 1 {
+                if !by_row.contains_key(&cell.row) {
+                    storage.tree_entry::<u16, Vec<&Cell>>()?;
+                }
+                storage.push(by_row.entry(cell.row).or_default(), cell)?;
+            }
+        }
+        let (mut narrowest, mut widest) = (u64::MAX, 0u64);
+        for (row, mut cells) in by_row {
+            storage.bytes(std::mem::size_of_val(cells.as_slice()))?;
+            cells.sort_by_key(|cell| cell.col);
+            let mut next_col = 0usize;
+            let mut total = 0u64;
+            let mut closing = !cells.is_empty();
+            for cell in cells {
+                let start = usize::from(cell.col);
+                let end = start.saturating_add(usize::from(cell.col_span));
+                if cell.col_span == 0 || start != next_col || end > col_count {
+                    closing = false;
+                    break;
+                }
+                total = total.saturating_add(u64::from(cell.width));
+                next_col = end;
+            }
+            if !closing || next_col != col_count {
+                continue;
+            }
+            if !exceeding.contains(&row) {
+                return Ok(false);
+            }
+            narrowest = narrowest.min(total);
+            widest = widest.max(total);
+        }
+        Ok(narrowest <= widest
+            && widest - narrowest <= ROW_AGREEMENT_TOLERANCE_PER_COLUMN_HU * col_count as u64)
+    }
+}
