@@ -0,0 +1,177 @@
+//! 편집한 글이 다단의 새 단으로 넘어간 자리를 저장 줄에 적는다.
+//!
+//! 다단 조판은 이 세션에 편집한 문단만 단 바닥에서 다음 단으로 넘기고(`Paragraph::
+//! edited_in_session`), 저장 줄은 앞 문단에 이어 붙인 vpos 그대로 둔다. 그 표지는 파일에
+//! 없으므로, 저장한 파일을 다시 열면 저장 사다리를 따르는 조판이 그 줄을 앞 단 바닥 아래에
+//! 그린다. 저장 사본에 한컴처럼 단 첫 줄의 vpos를 단 상단 좌표로 적으면 다시 연 파일도 같은
+//! 자리에서 단을 연다.
+use crate::document_core::tac_host_rows::{stored_line_continuing, FlowStart};
+use crate::document_core::DocumentCore;
+use crate::model::paragraph::{ColumnBreakType, LineSeg, Paragraph};
+use crate::renderer::pagination::{ColumnContent, PageItem};
+use crate::renderer::render_tree::{RenderNode, RenderNodeType};
+use crate::renderer::HWPUNIT_PER_INCH;
+
+impl DocumentCore {
+    /// 이 구역에서 조판이 다단의 단을 편집한 문단의 저장 줄로 열었는데 그 줄이 앞 저장 줄에
+    /// 이어 있는 자리와, 같은 저장 흐름에서 그 뒤에 조판이 연 단. 편집한 글을 따라 밀려난 뒤
+    /// 문단은 편집하지 않았어도 함께 옮겨야 다시 연 파일이 같은 자리에서 단을 연다.
+    /// `first_page`는 이 구역 첫 쪽의 문서 전체 쪽 번호다.
+    pub(crate) fn push_edited_column_starts(
+        &self,
+        section_idx: usize,
+        first_page: u32,
+        starts: &mut Vec<FlowStart>,
+    ) {
+        let (Some(result), Some(section)) = (
+            self.pagination.get(section_idx),
+            self.document.sections.get(section_idx),
+        ) else {
+            return;
+        };
+        let paragraphs = &section.paragraphs;
+        let mut moved_from = None;
+        for (page_idx, page) in result.pages.iter().enumerate() {
+            for (column_idx, column) in page.column_contents.iter().enumerate() {
+                let zone = column.zone_layout.as_ref().unwrap_or(&page.layout);
+                let Some((para_idx, line)) =
+                    column_start_line(column).filter(|_| zone.column_areas.len() >= 2)
+                else {
+                    moved_from = None;
+                    continue;
+                };
+                let Some(para) = paragraphs.get(para_idx) else {
+                    continue;
+                };
+                let follows_moved = moved_from
+                    .is_some_and(|from| stored_run_continues(paragraphs, from, (para_idx, line)));
+                if (line == 0 && para.column_type != ColumnBreakType::None)
+                    || stored_line_continuing(paragraphs, para_idx, line).is_none()
+                    || !(para.edited_in_session || follows_moved)
+                {
+                    moved_from = None;
+                    continue;
+                }
+                let top = self
+                    .drawn_line_top(
+                        first_page + page_idx as u32,
+                        column_idx,
+                        section_idx,
+                        para_idx,
+                    )
+                    .unwrap_or_else(|| {
+                        if line == 0 {
+                            self.spacing_before_hu(para)
+                        } else {
+                            0
+                        }
+                    });
+                // 명시 나누기 문단부터는 조판이 그 자리에서 단을 다시 열므로 저장 줄을 두고 간다.
+                let run_end = paragraphs[para_idx + 1..]
+                    .iter()
+                    .position(|next| next.column_type != ColumnBreakType::None)
+                    .map_or(paragraphs.len(), |offset| para_idx + 1 + offset);
+                starts.push(FlowStart {
+                    section: section_idx,
+                    para: para_idx,
+                    line,
+                    top,
+                    run_end,
+                });
+                moved_from = Some((para_idx, line));
+            }
+        }
+    }
+
+    /// 그 쪽의 `column_idx`번 단에 그린 문단의 맨 윗줄이 단 상단에서 떨어진 거리(HWPUNIT).
+    /// 단 상단은 같은 쪽의 한 단 영역 아래에서 시작하는 다단 영역의 상단이다.
+    fn drawn_line_top(
+        &self,
+        page: u32,
+        column_idx: usize,
+        section_idx: usize,
+        para_idx: usize,
+    ) -> Option<i32> {
+        let tree = self.build_page_tree_cached(page).ok()?;
+        let column = tree
+            .root
+            .children
+            .iter()
+            .filter(|node| matches!(node.node_type, RenderNodeType::Body { .. }))
+            .flat_map(|body| body.children.iter())
+            .filter(|node| matches!(node.node_type, RenderNodeType::Column(_)))
+            .nth(column_idx)?;
+        let line_y = topmost_line_y(column, section_idx, para_idx)?;
+        Some((((line_y - column.bbox.y) * HWPUNIT_PER_INCH / self.dpi).round() as i32).max(0))
+    }
+}
+
+/// `from` 줄부터 `to` 줄까지 저장 줄이 되감기지 않고 단·쪽 나누기도 없으면 true.
+fn stored_run_continues(
+    paragraphs: &[Paragraph],
+    from: (usize, usize),
+    to: (usize, usize),
+) -> bool {
+    let mut previous = None;
+    for para_idx in from.0..=to.0 {
+        let Some(para) = paragraphs.get(para_idx) else {
+            return false;
+        };
+        if para_idx > from.0 && para.column_type != ColumnBreakType::None {
+            return false;
+        }
+        let first = if para_idx == from.0 { from.1 } else { 0 };
+        let end = if para_idx == to.0 {
+            to.1 + 1
+        } else {
+            para.line_segs.len()
+        };
+        for seg in para.line_segs.iter().take(end).skip(first) {
+            if seg.tag & LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0 {
+                continue;
+            }
+            if previous.is_some_and(|previous| seg.vertical_pos < previous) {
+                return false;
+            }
+            previous = Some(seg.vertical_pos);
+        }
+    }
+    true
+}
+
+fn column_start_line(column: &ColumnContent) -> Option<(usize, usize)> {
+    match column.items.first()? {
+        PageItem::FullParagraph { para_index } | PageItem::Table { para_index, .. } => {
+            Some((*para_index, 0))
+        }
+        PageItem::PartialParagraph {
+            para_index,
+            start_line,
+            ..
+        } => Some((*para_index, *start_line)),
+        _ => None,
+    }
+}
+
+/// 본문 줄만 본다. 표 칸·글상자 안 줄의 문단 번호는 그 칸 안의 번호다.
+fn topmost_line_y(node: &RenderNode, section_idx: usize, para_idx: usize) -> Option<f64> {
+    if matches!(
+        node.node_type,
+        RenderNodeType::Table(_) | RenderNodeType::TableCell(_) | RenderNodeType::TextBox
+    ) {
+        return None;
+    }
+    let own = match &node.node_type {
+        RenderNodeType::TextLine(line)
+            if line.section_index == Some(section_idx) && line.para_index == Some(para_idx) =>
+        {
+            Some(node.bbox.y)
+        }
+        _ => None,
+    };
+    node.children
+        .iter()
+        .filter_map(|child| topmost_line_y(child, section_idx, para_idx))
+        .chain(own)
+        .reduce(f64::min)
+}
