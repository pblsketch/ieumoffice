+    /// 한/글이 저장한 단은 끝 문단 뒤에 저장 vpos 가 되감기고, 한/글의 단 높이는 엔진이 잰
+    /// 것보다 클 수 있다. 그래서 앞 문단 끝에 이어 붙었고 되감김이 없는 저장 줄만 단 바닥에서
+    /// 다음 단으로 넘긴다.
+    pub(in crate::renderer::typeset) fn follow_stored_ladder_past_column_foot(
+        &self,
+        st: &mut TypesetState,
+        para_idx: usize,
+        para: &Paragraph,
+        paragraphs: &[Paragraph],
+        styles: &ResolvedStyleSet,
+        formatted: &FormattedParagraph,
+    ) {
+        if st.col_count < 2 {
+            return;
+        }
+        let stored = |line: &&LineSeg| !is_synthetic_line_seg(line);
+        let px = |hu: i32| hwpunit_to_px(hu, self.dpi);
+        let spacing_after = |paragraph: &Paragraph| {
+            styles
+                .para_styles
+                .get(paragraph.para_shape_id as usize)
+                .map_or(0.0, |style| style.spacing_after)
+        };
+        let column = st.current_page_column();
+        let known = st
+            .column_stored_ladder
+            .filter(|ladder| ladder.column == column);
+        let previous = Self::previous_paragraph_in_column(st, para_idx, paragraphs)
+            .filter(|previous| !previous.line_segs.is_empty());
+        let (stored_minus_flow, draw_ahead, chained) =
+            if let Some(first) = para.line_segs.first().filter(stored) {
+                let line_y = px(first.vertical_pos);
+                let line_flow_y = st.current_height + formatted.spacing_before;
+                if st.current_items.is_empty() {
+                    st.record_column_stored_ladder(column, line_y - line_flow_y, 0.0);
+                    return;
+                }
+                let stored_minus_flow = known
+                    .map(|ladder| ladder.stored_minus_flow_px)
+                    .unwrap_or_else(|| {
+                        self.column_opening_stored_minus_flow(st, paragraphs, styles)
+                            .unwrap_or_else(|| (line_y - line_flow_y).min(0.0))
+                    });
+                let chained = previous.is_some_and(|previous| {
+                    let gap =
+                        px_to_hwpunit(spacing_after(previous) + formatted.spacing_before, self.dpi);
+                    paragraph_flow_end(previous).is_some_and(|end| {
+                        (0..=gap + 2).contains(&first.vertical_pos.saturating_sub(end))
+                    })
+                });
+                (
+                    stored_minus_flow,
+                    line_y - stored_minus_flow - line_flow_y,
+                    chained,
+                )
+            } else {
+                let Some(ladder) = known else {
+                    return;
+                };
+                let draw_ahead = previous
+                    .filter(|previous| previous.line_segs.last().is_some_and(|last| stored(&last)))
+                    .and_then(|previous| {
+                        Some(
+                            px(paragraph_flow_end(previous)?) - ladder.stored_minus_flow_px
+                                + spacing_after(previous)
+                                - st.current_height,
+                        )
+                    })
+                    .unwrap_or(ladder.draw_ahead_of_flow_px);
+                (ladder.stored_minus_flow_px, draw_ahead, true)
+            };
+        let draw_ahead = draw_ahead.max(0.0);
+        let no_stored_column_end = para
+            .line_segs
+            .windows(2)
+            .all(|pair| pair[1].vertical_pos >= pair[0].vertical_pos)
+            && paragraphs
+                .get(para_idx + 1)
+                .and_then(|next| next.line_segs.first().filter(stored))
+                .zip(para.line_segs.last())
+                .is_none_or(|(next, last)| next.vertical_pos >= last.vertical_pos);
+        let one_unit = self.dpi / 7200.0;
+        let past_foot = chained
+            && no_stored_column_end
+            && draw_ahead > one_unit
+            && st.current_height + draw_ahead + formatted.height_for_fit
+                > st.available_height() + one_unit;
+        let follow =
+            past_foot || (chained && draw_ahead > one_unit && st.ladder_passed_column_foot);
+        if follow {
+            st.align_flow_to(st.current_height + draw_ahead);
+        }
+        if past_foot {
+            st.mark_ladder_passed_column_foot();
+        }
+        st.record_column_stored_ladder(
+            column,
+            stored_minus_flow,
+            if follow { 0.0 } else { draw_ahead },
+        );
+    }
+
+    fn previous_paragraph_in_column<'a>(
+        st: &TypesetState,
+        para_idx: usize,
+        paragraphs: &'a [Paragraph],
+    ) -> Option<&'a Paragraph> {
+        let previous = para_idx.checked_sub(1)?;
+        let ends_the_column = st.current_items.last().is_some_and(|item| {
+            matches!(item,
+                PageItem::FullParagraph { para_index }
+                | PageItem::PartialParagraph { para_index, .. }
+                    if *para_index == previous)
+        });
+        ends_the_column.then(|| &paragraphs[previous])
+    }
+
+    fn column_opening_stored_minus_flow(
+        &self,
+        st: &TypesetState,
+        paragraphs: &[Paragraph],
+        styles: &ResolvedStyleSet,
+    ) -> Option<f64> {
+        let (index, line) = match st.current_items.first()? {
+            PageItem::FullParagraph { para_index } => (*para_index, 0),
+            PageItem::PartialParagraph {
+                para_index,
+                start_line,
+                ..
+            } => (*para_index, *start_line),
+            _ => return None,
+        };
+        let opener = paragraphs.get(index)?;
+        let spacing_before = if line == 0 {
+            styles
+                .para_styles
+                .get(opener.para_shape_id as usize)
+                .map_or(0.0, |style| style.spacing_before)
+        } else {
+            0.0
+        };
+        let line = opener
+            .line_segs
+            .get(line)
+            .filter(|line| !is_synthetic_line_seg(line))?;
+        Some(
+            hwpunit_to_px(line.vertical_pos, self.dpi) - (st.current_start_height + spacing_before),
+        )
+    }
