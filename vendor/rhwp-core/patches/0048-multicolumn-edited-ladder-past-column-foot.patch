+#![cfg(not(target_arch = "wasm32"))]
+use rhwp::model::control::Control;
+use rhwp::model::page::ColumnDef;
+use rhwp::model::paragraph::ColumnBreakType;
+use rhwp::renderer::render_tree::{RenderNode, RenderNodeType};
+use rhwp::wasm_api::HwpDocument;
+
+const LINES: usize = 260;
+const EIGHT_MM_COLUMN_GAP: i16 = 2268;
+const EXTENDED_CONTROL_UNITS: u32 = 8;
+const HANCOM_2024_PAGES: [(u16, u32); 2] = [(2, 4), (3, 3)];
+
+fn blank_with_columns(columns: u16) -> HwpDocument {
+    let mut doc = HwpDocument::create_empty();
+    doc.create_blank_document().unwrap();
+    doc.set_column_def_native(0, columns, 0, true, EIGHT_MM_COLUMN_GAP)
+        .unwrap();
+    doc
+}
+
+fn insert_every_line_as_a_new_paragraph(doc: &mut HwpDocument) {
+    doc.insert_text(0, 0, 0, "줄 1").unwrap();
+    for index in 1..LINES {
+        doc.insert_paragraph_native(0, index).unwrap();
+        doc.insert_text(0, index as u32, 0, &format!("줄 {}", index + 1))
+            .unwrap();
+    }
+}
+
+fn split_lines_off_the_paragraph_end(doc: &mut HwpDocument, after: usize, count: usize) {
+    for added in 0..count {
+        let at = after + added;
+        let length = doc.get_paragraph_length(0, at as u32).unwrap() as usize;
+        doc.split_paragraph_native(0, at, length, None).unwrap();
+        doc.insert_text(0, (at + 1) as u32, 0, &format!("새 줄 {}", added + 1))
+            .unwrap();
+    }
+}
+
+fn runs_below_their_column(doc: &HwpDocument) -> usize {
+    fn walk(node: &RenderNode, column_bottom: Option<f64>, below: &mut usize) {
+        let column_bottom = match &node.node_type {
+            RenderNodeType::Column(_) => Some(node.bbox.y + node.bbox.height),
+            _ => column_bottom,
+        };
+        if let (RenderNodeType::TextRun(run), Some(bottom)) = (&node.node_type, column_bottom) {
+            if !run.text.trim().is_empty() && node.bbox.y + node.bbox.height > bottom + 1.0 {
+                *below += 1;
+            }
+        }
+        for child in &node.children {
+            walk(child, column_bottom, below);
+        }
+    }
+    let mut below = 0;
+    for page in 0..doc.page_count() {
+        walk(
+            &doc.build_page_render_tree(page).unwrap().root,
+            None,
+            &mut below,
+        );
+    }
+    below
+}
+
+fn page_of(doc: &HwpDocument, para: usize) -> String {
+    doc.get_page_of_position_native(0, para).unwrap()
+}
+
+/// The saved file in both formats lays out on the same pages as the session, and the HWP
+/// save check reads it back with the same page count.
+fn reopens_as_laid_out(doc: &HwpDocument) {
+    let verify = doc.serialize_hwp_with_verify().unwrap();
+    assert_eq!(
+        verify.page_count_after, verify.page_count_before,
+        "HWP 저장 확인 쪽 수"
+    );
+    let paragraphs = doc.get_paragraph_count(0).unwrap() as usize;
+    for (format, bytes) in [
+        ("hwp", doc.export_hwp_native().unwrap()),
+        ("hwpx", doc.export_hwpx_native().unwrap()),
+    ] {
+        let reopened = HwpDocument::from_bytes(&bytes).unwrap();
+        assert_eq!(reopened.page_count(), doc.page_count(), "{format} 쪽 수");
+        assert_eq!(
+            runs_below_their_column(&reopened),
+            0,
+            "{format} 본문 아래 글"
+        );
+        for para in 0..paragraphs {
+            assert_eq!(
+                page_of(&reopened, para),
+                page_of(doc, para),
+                "{format} 문단 {para}의 쪽"
+            );
+        }
+    }
+}
+
+fn stored_positions(doc: &HwpDocument) -> Vec<Vec<i32>> {
+    doc.document().sections[0]
+        .paragraphs
+        .iter()
+        .map(|para| {
+            para.line_segs
+                .iter()
+                .map(|line| line.vertical_pos)
+                .collect()
+        })
+        .collect()
+}
+
+fn exam_paper() -> HwpDocument {
+    let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("samples/exam_eng.hwp");
+    HwpDocument::from_bytes(&std::fs::read(path).unwrap()).unwrap()
+}
+
+#[test]
+fn lines_added_after_the_columns_were_set_fill_columns_and_pages() {
+    for (columns, pages) in HANCOM_2024_PAGES {
+        let mut doc = blank_with_columns(columns);
+        insert_every_line_as_a_new_paragraph(&mut doc);
+        assert_eq!(doc.page_count(), pages, "{columns}단 쪽 수");
+        assert_eq!(runs_below_their_column(&doc), 0, "{columns}단 본문 아래 글");
+    }
+}
+
+#[test]
+fn the_layout_holds_after_save_and_reopen() {
+    for (columns, _) in HANCOM_2024_PAGES {
+        let mut doc = blank_with_columns(columns);
+        insert_every_line_as_a_new_paragraph(&mut doc);
+        reopens_as_laid_out(&doc);
+    }
+}
+
+#[test]
+fn lines_split_off_stored_lines_flow_into_the_next_columns() {
+    let untouched = exam_paper();
+    assert_eq!(untouched.page_count(), 8);
+    assert_eq!(runs_below_their_column(&untouched), 0);
+
+    const AFTER: usize = 20;
+    let mut doc = exam_paper();
+    split_lines_off_the_paragraph_end(&mut doc, AFTER, 100);
+    assert_eq!(runs_below_their_column(&doc), 0, "본문 아래 글");
+    for para in 0..=AFTER {
+        assert_eq!(
+            page_of(&doc, para),
+            page_of(&untouched, para),
+            "앞쪽 문단 {para}의 쪽"
+        );
+    }
+    reopens_as_laid_out(&doc);
+}
+
+#[test]
+fn a_thousand_lines_on_page_three_save_and_reopen_on_their_pages() {
+    // paragraph 138 lies in the first column of page 3, whose stored lines run on to an explicit
+    // column break; the .hwp save check refused this file when only the session knew the columns
+    const AFTER: usize = 138;
+    let mut doc = exam_paper();
+    split_lines_off_the_paragraph_end(&mut doc, AFTER, 1000);
+    assert_eq!(runs_below_their_column(&doc), 0, "본문 아래 글");
+    reopens_as_laid_out(&doc);
+}
+
+#[test]
+fn an_edit_that_moves_no_text_to_a_new_column_saves_the_lines_it_had() {
+    let mut doc = exam_paper();
+    let last = doc.get_paragraph_count(0).unwrap() as usize - 1;
+    split_lines_off_the_paragraph_end(&mut doc, last, 2);
+    let reopened = HwpDocument::from_bytes(&doc.export_hwp_native().unwrap()).unwrap();
+    assert_eq!(stored_positions(&reopened), stored_positions(&doc));
+}
+
+#[test]
+fn a_few_lines_at_the_end_leave_the_stored_pages_alone() {
+    let mut doc = exam_paper();
+    let last = doc.get_paragraph_count(0).unwrap() as usize - 1;
+    split_lines_off_the_paragraph_end(&mut doc, last, 2);
+    assert_eq!(doc.page_count(), 8);
+    assert_eq!(runs_below_their_column(&doc), 0);
+}
+
+#[test]
+fn paragraphs_laid_out_again_behind_stored_ones_flow_too() {
+    let mut doc = exam_paper();
+    let last = doc.get_paragraph_count(0).unwrap() as usize - 1;
+    split_lines_off_the_paragraph_end(&mut doc, last, 100);
+    doc.reflow_body_paragraph_range_native(0, last + 1..last + 101)
+        .unwrap();
+    assert_eq!(runs_below_their_column(&doc), 0, "본문 아래 글");
+}
+
+#[test]
+fn lines_added_below_a_one_column_head_flow_into_the_two_column_body() {
+    let mut doc = HwpDocument::create_empty();
+    doc.create_blank_document().unwrap();
+    doc.insert_text(0, 0, 0, "머리").unwrap();
+    split_lines_off_the_paragraph_end(&mut doc, 0, 2);
+    let paragraph = &mut doc.document_mut().sections[0].paragraphs[2];
+    paragraph.column_type = ColumnBreakType::MultiColumn;
+    paragraph.raw_break_type = 0x02;
+    paragraph.align_ctrl_data_records();
+    paragraph.controls.insert(
+        0,
+        Control::ColumnDef(ColumnDef {
+            column_count: 2,
+            same_width: true,
+            spacing: EIGHT_MM_COLUMN_GAP,
+            ..Default::default()
+        }),
+    );
+    paragraph.ctrl_data_records.insert(0, None);
+    for offset in &mut paragraph.char_offsets {
+        *offset += EXTENDED_CONTROL_UNITS;
+    }
+    for shape in paragraph
+        .char_shapes
+        .iter_mut()
+        .filter(|shape| shape.start_pos > 0)
+    {
+        shape.start_pos += EXTENDED_CONTROL_UNITS;
+    }
+    paragraph.char_count += EXTENDED_CONTROL_UNITS;
+    doc.reflow_body_paragraph_range_native(0, 2..3).unwrap();
+
+    for index in 3..3 + LINES {
+        doc.insert_paragraph_native(0, index).unwrap();
+        doc.insert_text(0, index as u32, 0, &format!("본문 {index}"))
+            .unwrap();
+    }
+    assert_eq!(runs_below_their_column(&doc), 0, "본문 아래 글");
+    assert!(
+        doc.page_count() <= 4,
+        "두 단을 채운다: {}쪽",
+        doc.page_count()
+    );
+    reopens_as_laid_out(&doc);
+}
