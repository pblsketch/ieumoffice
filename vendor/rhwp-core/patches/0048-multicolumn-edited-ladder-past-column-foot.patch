+    /// 잰다. 단을 여는 문단은 제 줄이 단 위끝에 놓인다. 표 따위가 단을 열었으면 저장 사다리를
+    /// 쪽 기준으로 보되, 흐름이 그보다 아래에 있으면 흐름을 따른다. 엔진이 다시 짠 문단은
+    /// 저장 자리가 없으므로 앞 저장 문단의 저장 끝에서 이어진다.
+    ///
+    /// 그렇게 넘긴 뒤로는 구역 끝까지 한/글이 조판한 자리가 아니다(뒤 단의 글은 한/글이 둔
+    /// 단·쪽에서 밀려났다). 그 뒤의 문단은 흐름이 사다리를 그대로 따른다. 흐름이 뒤처진 채
+    /// 두면 흐름 자리에 놓이는 글자처럼 취급 표가 저장 자리에 그린 앞 글 위로 올라간다.
+    pub(in crate::renderer::typeset) fn follow_stored_ladder_past_column_foot(
+        &self,
+        st: &mut TypesetState,
+        para_idx: usize,
+        para: &Paragraph,
+        paragraphs: &[Paragraph],
+        styles: &ResolvedStyleSet,
+        formatted: &FormattedParagraph,
+    ) {
+        if st.col_count < 2 {
+            return;
+        }
+        let stored = |line: &&crate::model::paragraph::LineSeg| !is_synthetic_line_seg(line);
+        let px = |hu: i32| hwpunit_to_px(hu, self.dpi);
+        // 줄 전진량은 `recalculate_section_vpos` 와 같은 TAC th 관례로 센다.
+        let line_end = |line: &crate::model::paragraph::LineSeg| {
+            let height = if line.line_height > line.text_height && line.text_height > 0 {
+                line.text_height
+            } else {
+                line.line_height
+            };
+            line.vertical_pos
+                .saturating_add(height)
+                .saturating_add(line.line_spacing)
+        };
+        let column = (st.pages.len(), st.current_column);
+        let known = st
+            .column_stored_ladder
+            .filter(|ladder| ladder.column == column);
+        // 이 단의 마지막 항목이 바로 앞 문단일 때, 그 문단의 끝 줄과 아래 간격.
+        let previous = para_idx
+            .checked_sub(1)
+            .filter(|previous| {
+                st.current_items.last().is_some_and(|item| {
+                    matches!(item,
+                        PageItem::FullParagraph { para_index }
+                        | PageItem::PartialParagraph { para_index, .. }
+                            if para_index == previous)
+                })
+            })
+            .and_then(|previous| {
+                let previous = &paragraphs[previous];
+                let spacing_after = styles
+                    .para_styles
+                    .get(previous.para_shape_id as usize)
+                    .map_or(0.0, |style| style.spacing_after);
+                Some((previous.line_segs.last()?, spacing_after))
+            });
+        let (offset, lead, chained) = if let Some(first) = para.line_segs.first().filter(stored) {
+            let line_y = px(first.vertical_pos);
+            let line_flow_y = st.current_height + formatted.spacing_before;
+            if st.current_items.is_empty() {
+                st.record_column_stored_ladder(column, line_y - line_flow_y, 0.0);
+                return;
+            }
+            let offset = known.map(|ladder| ladder.offset).unwrap_or_else(|| {
+                self.column_opening_ladder_offset(st, paragraphs, styles)
+                    .unwrap_or_else(|| (line_y - line_flow_y).min(0.0))
+            });
+            let chained = previous.is_some_and(|(last, spacing_after)| {
+                let gap = crate::renderer::px_to_hwpunit(
+                    spacing_after + formatted.spacing_before,
+                    self.dpi,
+                );
+                (0..=gap + 2).contains(&first.vertical_pos.saturating_sub(line_end(last)))
+            });
+            (offset, line_y - offset - line_flow_y, chained)
+        } else {
+            let Some(ladder) = known else {
+                return;
+            };
+            let lead = previous.filter(|(last, _)| stored(last)).map_or(
+                ladder.lead,
+                |(last, spacing_after)| {
+                    px(line_end(last)) - ladder.offset + spacing_after - st.current_height
+                },
+            );
+            (ladder.offset, lead, true)
+        };
+        let lead = lead.max(0.0);
+        let ladder_goes_on = para
+            .line_segs
+            .windows(2)
+            .all(|pair| pair[1].vertical_pos >= pair[0].vertical_pos)
+            && paragraphs
+                .get(para_idx + 1)
+                .and_then(|next| next.line_segs.first().filter(stored))
+                .zip(para.line_segs.last())
+                .is_none_or(|(next, last)| next.vertical_pos >= last.vertical_pos);
+        let one_unit = self.dpi / 7200.0;
+        let past_foot = chained
+            && ladder_goes_on
+            && lead > one_unit
+            && st.current_height + lead + formatted.height_for_fit
+                > st.available_height() + one_unit;
+        let follow = past_foot || (chained && lead > one_unit && st.following_stored_ladder);
+        if follow {
+            st.align_flow_to(st.current_height + lead);
+        }
+        if past_foot {
+            st.follow_stored_ladder_from_now();
+        }
+        st.record_column_stored_ladder(column, offset, if follow { 0.0 } else { lead });
+    }
+
+    /// 저장 문단(조각)이 이 단을 열었을 때, 그 첫 줄의 저장 자리와 흐름 자리의 차(px).
+    fn column_opening_ladder_offset(
+        &self,
+        st: &TypesetState,
+        paragraphs: &[Paragraph],
+        styles: &ResolvedStyleSet,
+    ) -> Option<f64> {
+        let (index, line) = match st.current_items.first()? {
+            PageItem::FullParagraph { para_index } => (*para_index, 0),
+            PageItem::PartialParagraph {
+                para_index,
+                start_line,
+                ..
+            } => (*para_index, *start_line),
+            _ => return None,
+        };
+        let opener = paragraphs.get(index)?;
+        let spacing_before = if line == 0 {
+            styles
+                .para_styles
+                .get(opener.para_shape_id as usize)
+                .map_or(0.0, |style| style.spacing_before)
+        } else {
+            0.0
+        };
+        let line = opener
+            .line_segs
+            .get(line)
+            .filter(|line| !is_synthetic_line_seg(line))?;
+        Some(
+            hwpunit_to_px(line.vertical_pos, self.dpi) - (st.current_start_height + spacing_before),
+        )
+    }
