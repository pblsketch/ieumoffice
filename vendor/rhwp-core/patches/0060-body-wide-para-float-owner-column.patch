diff --git a/tests/cases/body_wide_para_float_columns.rs b/tests/cases/body_wide_para_float_columns.rs
new file mode 100644
index 00000000..8cc8ec9a
--- /dev/null
+++ b/tests/cases/body_wide_para_float_columns.rs
@@ -0,0 +1,190 @@
+#![cfg(not(target_arch = "wasm32"))]
+//! Body-wide `VertRelTo::Para` + `TopAndBottom` head table in a 2-column section.
+//!
+//! When paragraph 0 in column 0 anchors a floating table spanning the full body
+//! width (`treatAsChar = false`, `textWrap = TopAndBottom`, `vertRelTo = Para`,
+//! `vertAlign = Top`, `vertOffset = 0`), column 0 owns and lays out the table
+//! in flow at the body top, while column 1 and the column separator start below
+//! the table. Previously `calculate_body_wide_shape_reserved` pre-pushed column 0's
+//! `y_offset` past the table before laying it out, pushing the paragraph-relative
+//! table down by its own height so it overlapped both column 0's next paragraph
+//! and column 1, while the column separator cut through the table from `body_top`.
+use rhwp::renderer::render_tree::{RenderNode, RenderNodeType};
+use rhwp::wasm_api::HwpDocument;
+
+const EIGHT_MM_COLUMN_GAP: i16 = 2268;
+const LINES: usize = 60;
+
+fn blank() -> HwpDocument {
+    let mut doc = HwpDocument::create_empty();
+    doc.create_blank_document().unwrap();
+    doc
+}
+
+fn fill_lines(doc: &mut HwpDocument, first_para: usize, lines: usize) {
+    for index in 0..lines {
+        let para = first_para + index;
+        if index > 0 {
+            doc.insert_paragraph_native(0, para).unwrap();
+        }
+        doc.insert_text(
+            0,
+            para as u32,
+            0,
+            &format!("Question {:03} sample body line", index + 1),
+        )
+        .unwrap();
+    }
+}
+
+fn two_columns_with_line(doc: &mut HwpDocument) {
+    doc.set_column_def_native(0, 2, 0, true, EIGHT_MM_COLUMN_GAP)
+        .unwrap();
+    doc.set_column_separator(0, r##"{"type":1,"width":1,"color":"#112233"}"##)
+        .unwrap();
+}
+
+fn json_field<'a>(json: &'a str, key: &str) -> &'a str {
+    let start = json.find(&format!("\"{}\":", key)).unwrap() + key.len() + 3;
+    let rest = &json[start..];
+    let end = rest.find([',', '}']).unwrap();
+    &rest[..end]
+}
+
+struct PageGeometry {
+    body_top: f64,
+    separators: Vec<(f64, f64, f64)>,
+    column_text_tops: Vec<f64>,
+    table_top: Option<f64>,
+    table_bottom: Option<f64>,
+}
+
+fn page_geometry(doc: &HwpDocument, page: u32) -> PageGeometry {
+    fn has_text_run(node: &RenderNode) -> bool {
+        matches!(&node.node_type, RenderNodeType::TextRun(run) if !run.text.trim().is_empty())
+            || node.children.iter().any(has_text_run)
+    }
+    fn first_text_line_top(node: &RenderNode) -> Option<f64> {
+        if matches!(node.node_type, RenderNodeType::TextLine(_)) {
+            return has_text_run(node).then_some(node.bbox.y);
+        }
+        if matches!(node.node_type, RenderNodeType::Table(_)) {
+            return None;
+        }
+        node.children.iter().find_map(first_text_line_top)
+    }
+    fn walk(node: &RenderNode, out: &mut PageGeometry) {
+        match &node.node_type {
+            RenderNodeType::Body { .. } => {
+                out.body_top = node.bbox.y;
+                for child in &node.children {
+                    if let RenderNodeType::Line(line) = &child.node_type {
+                        if (line.x1 - line.x2).abs() < 0.01 {
+                            out.separators.push((line.x1, line.y1, line.y2));
+                        }
+                    }
+                }
+            }
+            RenderNodeType::Column(_) => {
+                if let Some(top) = node.children.iter().find_map(first_text_line_top) {
+                    out.column_text_tops.push(top);
+                }
+            }
+            RenderNodeType::Table(_) => {
+                out.table_top = Some(node.bbox.y);
+                out.table_bottom = Some(node.bbox.y + node.bbox.height);
+                return;
+            }
+            _ => {}
+        }
+        for child in &node.children {
+            walk(child, out);
+        }
+    }
+    let mut out = PageGeometry {
+        body_top: 0.0,
+        separators: Vec::new(),
+        column_text_tops: Vec::new(),
+        table_top: None,
+        table_bottom: None,
+    };
+    walk(&doc.build_page_render_tree(page).unwrap().root, &mut out);
+    out
+}
+
+fn para_head_table(doc: &mut HwpDocument) -> (usize, f64, f64) {
+    let made = doc.create_table_native(0, 0, 0, 3, 6).unwrap();
+    let para: usize = json_field(&made, "paraIdx").parse().unwrap();
+    let control: u32 = json_field(&made, "controlIdx").parse().unwrap();
+    doc.set_table_properties_native(
+        0,
+        para,
+        control as usize,
+        r#"{"treatAsChar":false,"textWrap":"TopAndBottom","vertRelTo":"Para","horzRelTo":"Page","vertAlign":"Top","horzAlign":"Left","vertOffset":0,"horzOffset":0}"#,
+    )
+    .unwrap();
+    let props = doc.get_table_properties(0, para as u32, control).unwrap();
+    let outer_top: f64 = json_field(&props, "outerTop").parse().unwrap();
+    let outer_bottom: f64 = json_field(&props, "outerBottom").parse().unwrap();
+    (
+        para + 1,
+        outer_top * 96.0 / 7200.0,
+        outer_bottom * 96.0 / 7200.0,
+    )
+}
+
+#[test]
+fn para_anchored_body_wide_head_table_stays_at_body_top_without_overlapping_columns() {
+    let mut doc = blank();
+    let (first_line, outer_top, outer_bottom) = para_head_table(&mut doc);
+    fill_lines(&mut doc, first_line, LINES);
+    two_columns_with_line(&mut doc);
+
+    let g = page_geometry(&doc, 0);
+    let table_top = g.table_top.expect("head table drawn");
+    let table_bottom = g.table_bottom.expect("head table drawn");
+    let reserved_bottom = table_bottom + outer_bottom;
+
+    // Owner column must not pre-push the paragraph-relative head table down by its own height.
+    assert!(
+        (table_top - (g.body_top + outer_top)).abs() < 0.01,
+        "head table top {table_top} should sit at body_top {} + outer_top {outer_top}",
+        g.body_top
+    );
+
+    // Both columns' body text must start at the table's reserved bottom (no overlap).
+    assert_eq!(g.column_text_tops.len(), 2, "both columns hold text");
+    for text_top in &g.column_text_tops {
+        assert!(
+            (text_top - reserved_bottom).abs() < 0.01,
+            "column text top {text_top} vs head table reserved bottom {reserved_bottom}"
+        );
+    }
+
+    // Column separator starts below the head table, not at body_top through it.
+    assert_eq!(g.separators.len(), 1);
+    let (_, sep_top, _) = g.separators[0];
+    assert!(
+        (sep_top - reserved_bottom).abs() < 0.01,
+        "separator top {sep_top} should start at head table reserved bottom {reserved_bottom}"
+    );
+}
+
+#[test]
+fn para_anchored_head_table_with_left_column_only_starts_separator_below_table() {
+    let mut doc = blank();
+    let (first_line, outer_top, outer_bottom) = para_head_table(&mut doc);
+    fill_lines(&mut doc, first_line, 4);
+    two_columns_with_line(&mut doc);
+
+    let g = page_geometry(&doc, 0);
+    let table_top = g.table_top.expect("head table drawn");
+    let table_bottom = g.table_bottom.expect("head table drawn");
+    let reserved_bottom = table_bottom + outer_bottom;
+
+    assert!((table_top - (g.body_top + outer_top)).abs() < 0.01);
+    assert_eq!(g.column_text_tops.len(), 1, "only left column holds text");
+    assert!((g.column_text_tops[0] - reserved_bottom).abs() < 0.01);
+    assert_eq!(g.separators.len(), 1);
+    assert!((g.separators[0].1 - reserved_bottom).abs() < 0.01);
+}
