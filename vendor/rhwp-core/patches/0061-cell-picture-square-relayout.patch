+/// [ieum 0061] 셀 첫 문단의 첫 줄이 그 문단의 어울림 개체 **아래로 내려간** 높이(px).
+///
+/// 옆에 글이 들어갈 폭이 없으면 한/글은 첫 줄을 개체 아래에 둔다 — 좁은 서명 칸의 도장:
+/// 그림 높이 3675HU, 저장 첫 줄 vertpos 3675, "(서명)"이 도장 아래 한 줄. 문단 원점은 칸
+/// 위이고 첫 줄만 그만큼 아래다. 그 띠는 셀 높이에 들어가고 글줄도 그만큼 내려가야 한다.
+/// 첫 줄 자리가 문단 기준 어울림 개체의 아래끝(오프셋+높이+위아래 바깥 여백)과 같을 때만
+/// 그 값을 낸다(어울림 밴드가 줄을 내리는 자리가 정확히 그 끝이다). 그 밖에는 0.
+/// 글 없이 개체만 든 문단은 빈 그림 문단의 띠 경로가 높이를 이미 맡으므로 여기서 더하지
+/// 않는다(더하면 그 띠를 두 번 세어 칸 안 그림이 가운데에서 밀려난다).
+pub(crate) fn cell_first_para_float_lead(
+    para: &crate::model::paragraph::Paragraph,
+    dpi: f64,
+) -> f64 {
+    use crate::model::control::Control;
+    use crate::model::shape::{TextWrap, VertRelTo};
+    let Some(first) = para.line_segs.first() else {
+        return 0.0;
+    };
+    if first.vertical_pos <= 0 || para.text.trim().is_empty() {
+        return 0.0;
+    }
+    let float_bottom = para
+        .controls
+        .iter()
+        .filter_map(|control| {
+            let common = match control {
+                Control::Picture(picture) => &picture.common,
+                Control::Shape(shape) => shape.common(),
+                _ => return None,
+            };
+            let offset = common.vertical_offset as i32;
+            (!common.treat_as_char
+                && matches!(
+                    common.text_wrap,
+                    TextWrap::Square | TextWrap::Tight | TextWrap::Through
+                )
+                && common.vert_rel_to == VertRelTo::Para
+                && offset >= 0)
+                .then(|| {
+                    offset
+                        .saturating_add(common.height.min(i32::MAX as u32) as i32)
+                        .saturating_add(i32::from(common.margin.top))
+                        .saturating_add(i32::from(common.margin.bottom))
+                })
+        })
+        .max();
+    match float_bottom {
+        Some(bottom) if (first.vertical_pos - bottom).abs() <= 8 => {
+            hwpunit_to_px(first.vertical_pos, dpi)
+        }
+        _ => 0.0,
+    }
+}
