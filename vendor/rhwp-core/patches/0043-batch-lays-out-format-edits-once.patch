+#[cfg(test)]
+mod batch_layout_deferral_tests {
+    //! [ieum] 배치 안의 문단 모양·스타일·머리말 서식과 표·칸·그림·주석 편집은 구역을
+    //! 호출마다 다시 배치하지 않고 `end_batch_native` 에서 한 번 배치하며, 결과는 호출마다
+    //! 배치한 것과 같다.
+
+    use crate::document_core::DocumentCore;
+    use crate::model::control::Control;
+
+    const PNG: [u8; 70] = [
+        0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0x00, 0x00, 0x00, 0x0d, 0x49, 0x48, 0x44,
+        0x52, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x01, 0x08, 0x06, 0x00, 0x00, 0x00, 0x1f,
+        0x15, 0xc4, 0x89, 0x00, 0x00, 0x00, 0x0d, 0x49, 0x44, 0x41, 0x54, 0x78, 0xda, 0x63, 0xfc,
+        0xcf, 0xc0, 0xf0, 0x1f, 0x00, 0x05, 0x05, 0x02, 0x00, 0x5f, 0xc8, 0xf1, 0xd2, 0x00, 0x00,
+        0x00, 0x00, 0x49, 0x45, 0x4e, 0x44, 0xae, 0x42, 0x60, 0x82,
+    ];
+
+    /// Thirty short body paragraphs on one page.
+    fn document() -> DocumentCore {
+        let mut doc = DocumentCore::new_empty();
+        doc.create_blank_document_native().expect("blank document");
+        for para in 0..30 {
+            if para > 0 {
+                doc.split_paragraph_native(0, para - 1, 3, None)
+                    .expect("split");
+            }
+            doc.insert_text_native(0, para, 0, "앞ㅎ뒤").expect("type");
+        }
+        doc
+    }
+
+    /// Page geometry, a caret in every paragraph, every page drawn, and both saved forms.
+    fn result(doc: &DocumentCore) -> (Vec<String>, Vec<String>, Vec<String>, Vec<u8>, Vec<u8>) {
+        let pages = doc.page_count();
+        (
+            (0..pages)
+                .map(|page| doc.get_page_info_native(page).expect("page"))
+                .collect(),
+            (0..doc.document().sections[0].paragraphs.len())
+                .map(|para| doc.get_cursor_rect_native(0, para, 1).expect("caret"))
+                .collect(),
+            (0..pages)
+                .map(|page| doc.render_page_svg_native(page).expect("svg"))
+                .collect(),
+            doc.export_hwp_native().expect("hwp"),
+            doc.export_hwpx_native().expect("hwpx"),
+        )
+    }
+
+    fn alignment(doc: &DocumentCore, para: usize) -> String {
+        let props: serde_json::Value =
+            serde_json::from_str(&doc.get_para_properties_at_native(0, para).expect("props"))
+                .expect("json");
+        props["alignment"].as_str().expect("alignment").to_string()
+    }
+
+    fn shape_paragraphs(doc: &mut DocumentCore) {
+        for para in 0..30 {
+            doc.apply_para_format_native(
+                0,
+                para,
+                r#"{"alignment":"center","spacingBefore":4000,"lineSpacingType":"Percent","lineSpacing":200}"#,
+            )
+            .expect("paragraph format");
+            if para % 3 == 1 {
+                doc.apply_style_native(0, para, 2).expect("style");
+            }
+            if para % 5 == 4 {
+                let first = doc.document().sections[0].paragraphs[0].para_shape_id;
+                doc.set_para_shape_id_native(0, para, first)
+                    .expect("shape id");
+            }
+        }
+    }
+
+    #[test]
+    fn paragraph_formats_and_styles_lay_out_once_at_end_batch() {
+        let mut eager = document();
+        let mut batched = document();
+        let before = batched.page_count();
+        shape_paragraphs(&mut eager);
+        batched.begin_batch_native().expect("begin");
+        shape_paragraphs(&mut batched);
+        assert!(
+            eager.page_count() > before,
+            "the formats move the page breaks"
+        );
+        assert_eq!(
+            batched.page_count(),
+            before,
+            "applyParaFormat, applyStyle and setParaShapeId leave the layout to endBatch"
+        );
+        assert_eq!(
+            alignment(&batched, 29),
+            "center",
+            "the shape reads back inside the batch"
+        );
+        batched.end_batch_native().expect("end");
+        assert!(
+            result(&batched) == result(&eager),
+            "one layout at endBatch, same result"
+        );
+    }
+
+    fn with_header(mut doc: DocumentCore) -> DocumentCore {
+        doc.create_header_footer_native(0, true, 0).expect("header");
+        doc.insert_text_in_header_footer_native(0, true, 0, 0, 0, "머리말 글")
+            .expect("header text");
+        doc
+    }
+
+    fn shape_header(doc: &mut DocumentCore) {
+        for para in 0..30 {
+            // a deferred body edit that moves the page breaks, then the header formats
+            doc.apply_char_format_native(0, para, 1, 2, r#"{"fontSize":3000}"#)
+                .expect("body chars");
+            doc.apply_para_format_in_hf_native(0, true, 0, 0, r#"{"alignment":"right"}"#)
+                .expect("header paragraph");
+            doc.apply_char_format_in_header_footer_native(
+                0,
+                true,
+                0,
+                0,
+                0,
+                0,
+                2,
+                &format!(r#"{{"bold":{}}}"#, para % 2 == 0),
+            )
+            .expect("header chars");
+        }
+    }
+
+    #[test]
+    fn header_footer_formats_lay_out_once_at_end_batch() {
+        let mut eager = with_header(document());
+        let mut batched = with_header(document());
+        let before = batched.page_count();
+        shape_header(&mut eager);
+        batched.begin_batch_native().expect("begin");
+        shape_header(&mut batched);
+        assert!(
+            eager.page_count() > before,
+            "the body formats move the page breaks"
+        );
+        assert_eq!(
+            batched.page_count(),
+            before,
+            "applyParaFormatInHf and applyCharFormatInHeaderFooter leave the layout to endBatch"
+        );
+        batched.end_batch_native().expect("end");
+        assert!(
+            result(&batched) == result(&eager),
+            "one layout at endBatch, same result"
+        );
+    }
+
+    /// The document with a 2×2 table in paragraph 5, a picture in paragraph 8 and a
+    /// footnote in paragraph 20.
+    fn with_objects(mut doc: DocumentCore) -> DocumentCore {
+        doc.create_table_native(0, 5, 0, 2, 2).expect("table");
+        doc.insert_picture_native(0, 8, 0, &[], &PNG, 3000, 3000, 1, 1, "png", "", None, None)
+            .expect("picture");
+        doc.insert_footnote_native(0, 20, 1)
+            .expect("later footnote");
+        doc
+    }
+
+    fn control(doc: &DocumentCore, para: usize, is: fn(&Control) -> bool) -> usize {
+        doc.document().sections[0].paragraphs[para]
+            .controls
+            .iter()
+            .position(is)
+            .expect("control")
+    }
+
+    fn edit_objects(doc: &mut DocumentCore) {
+        let table = control(doc, 5, |c| matches!(c, Control::Table(_)));
+        for cell in 0..4 {
+            doc.set_cell_properties_native(
+                0,
+                5,
+                table,
+                cell,
+                r##"{"verticalAlign":1,"paddingLeft":700,"fillType":"solid","fillColor":"#d9e2f3","patternType":-1}"##,
+            )
+            .expect("cell");
+        }
+        doc.set_table_properties_native(0, 5, table, r#"{"repeatHeader":true}"#)
+            .expect("table");
+        let picture = control(doc, 8, |c| matches!(c, Control::Picture(_)));
+        doc.set_picture_properties_native(0, 8, picture, r#"{"treatAsChar":true}"#)
+            .expect("picture");
+        // ahead of the footnote in paragraph 20, which becomes the second one
+        doc.insert_footnote_native(0, 10, 1).expect("footnote");
+        doc.insert_endnote_native(0, 12, 1).expect("endnote");
+    }
+
+    #[test]
+    fn table_picture_and_note_edits_in_a_batch_match_eager_edits() {
+        let mut eager = with_objects(document());
+        let mut batched = with_objects(document());
+        edit_objects(&mut eager);
+        batched.begin_batch_native().expect("begin");
+        edit_objects(&mut batched);
+        batched.end_batch_native().expect("end");
+        let later = control(&batched, 20, |c| matches!(c, Control::Footnote(_)));
+        let Control::Footnote(note) =
+            &batched.document().sections[0].paragraphs[20].controls[later]
+        else {
+            panic!("footnote");
+        };
+        assert_eq!(
+            note.number, 2,
+            "the earlier insert renumbered the later footnote"
+        );
+        assert!(
+            result(&batched) == result(&eager),
+            "one layout at endBatch, same result"
+        );
+    }
+}
