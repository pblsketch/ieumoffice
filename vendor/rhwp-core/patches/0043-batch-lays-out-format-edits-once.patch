+    /// [ieum] 문단 모양·스타일·머리말 서식 뮤테이터의 `rebuild_section` 꼬리.
+    ///
+    /// 배치 밖에서는 종전대로 구역 전체를 다시 조합하고 쪽을 나눈다. 배치 중에는 스타일
+    /// 해석만 갱신하고, 고친 본문 문단(머리말·꼬리말 문단이면 None)의 조합과 구역의 측정·
+    /// 쪽 나누기를 `recompose_section_at_batch_end` 처럼 `end_batch_native` 로 넘긴다.
+    pub(crate) fn rebuild_section_at_batch_end(&mut self, sec_idx: usize, para_idx: Option<usize>) {
+        if !self.batch_mode {
+            self.rebuild_section(sec_idx);
+            return;
+        }
+        self.rebuild_section_deferred_in_batch(sec_idx);
+        self.recompose_section_at_batch_end(sec_idx, para_idx.as_slice());
+    }
+
+    /// [ieum] 표·칸·그림·주석 뮤테이터의 `recompose_section` 꼬리.
+    ///
+    /// 배치 밖에서는 종전대로 구역 전체를 다시 조합한다. 배치 중에는 조합이 바뀐 문단
+    /// (`paras`)만 다시 조합하고 구역의 문단을 모두 다시 재도록 표시해, 측정과 쪽 나누기를
+    /// `end_batch_native` 의 paginate 1회에 맡긴다. 손대지 않은 문단은 다시 조합해도 결과가
+    /// 같은데 비용은 구역 크기라, 문단·칸마다 서식을 입히는 배치가 구역 크기의 제곱으로
+    /// 느려졌다. 구역 전체를 다시 재게 하는 것은 배치 밖의 `recompose_section` 이 남기던
+    /// 상태와 같게 하려는 것이다. 고친 문단만 다시 재면, 뒤 문단의 저장 위치가 옮겨져도 표는
+    /// 옛 측정을 써서 그린 행 높이가 호출마다 배치한 결과와 1e-14px 단위로 달라진다.
+    pub(crate) fn recompose_section_at_batch_end(&mut self, sec_idx: usize, paras: &[usize]) {
+        if !self.batch_mode {
+            self.recompose_section(sec_idx);
+            return;
+        }
+        self.invalidate_page_tree_cache();
+        for &para_idx in paras {
+            self.recompose_paragraph(sec_idx, para_idx);
+        }
+        self.mark_section_dirty(sec_idx);
+        if sec_idx < self.dirty_paragraphs.len() {
+            self.dirty_paragraphs[sec_idx] = None;
+        }
+    }
