+    /// [ieum] 각주·미주 넣기의 `recompose_section` 꼬리(`recompose_section_at_batch_end`).
+    ///
+    /// 넣은 주석 뒤의 주석은 번호가 하나씩 밀리고, 조합 결과(`footnote_positions`)가 그
+    /// 번호를 든다. 그래서 배치 중에는 넣은 문단과 그 뒤의 주석 든 문단을 다시 조합한다.
+    fn recompose_note_paragraphs_at_batch_end(&mut self, section_idx: usize, para_idx: usize) {
+        let mut paras = vec![para_idx];
+        if self.batch_mode {
+            let later = &self.document.sections[section_idx].paragraphs[para_idx + 1..];
+            paras.extend(
+                later
+                    .iter()
+                    .enumerate()
+                    .filter(|(_, para)| {
+                        para.controls
+                            .iter()
+                            .any(|c| matches!(c, Control::Footnote(_) | Control::Endnote(_)))
+                    })
+                    .map(|(offset, _)| para_idx + 1 + offset),
+            );
+        }
+        self.recompose_section_at_batch_end(section_idx, &paras);
+    }
 }
 
