+    /// 그 문단은 머리말 API(`split_paragraph_in_header_footer` 등)가 맡는다 — 패치 전과 같다.
+    fn reject_header_footer_root_for_split_merge(
+        &self,
+        section_idx: usize,
+        parent_para_idx: usize,
+        path: &[(usize, usize, usize)],
+    ) -> Result<(), HwpError> {
+        if let [(ctrl_idx, _, _)] = path {
+            let control = self
+                .document
+                .sections
+                .get(section_idx)
+                .and_then(|s| s.paragraphs.get(parent_para_idx))
+                .and_then(|p| p.controls.get(*ctrl_idx));
+            if matches!(control, Some(Control::Header(_) | Control::Footer(_))) {
+                return Err(HwpError::RenderError(
+                    "경로: 머리말·꼬리말 문단은 머리말 API로 고칩니다".to_string(),
+                ));
+            }
+        }
+        Ok(())
+    }
